[project]
title = GLOW
version = 0.1.0
custom_resources = /content

[bootstrap]
main_collection = /main/main.collectionc
render = /render/glow.renderc

[display]
width = 720
height = 1280
high_dpi = 1
fullscreen = 0
vsync = 1
swap_interval = 1
update_frequency = 0

[render]
clear_color_red = 0.5254902
clear_color_green = 0.8666667
clear_color_blue = 1.0
clear_color_alpha = 1.0

[script]
shared_state = 1

[input]
game_binding = /input/game.input_bindingc

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear
max_draw_calls = 2048
max_characters = 16384

[sprite]
max_count = 1024

[particle_fx]
max_count = 128
max_emitter_count = 256
max_particle_count = 2048

[gui]
max_count = 64
max_animation_count = 2048
max_particle_count = 1024

[collection]
max_instances = 2048

[collection_proxy]
max_count = 16

[factory]
max_count = 256

[collectionfactory]
max_count = 64

[label]
max_count = 256

[sound]
max_sound_data = 512
max_sound_buffers = 128
max_sound_sources = 64
max_sound_instances = 256
max_component_count = 256

[resource]
max_resources = 2048

[html5]
scale_mode = stretch
show_fullscreen_button = 0
show_made_with_defold = 0
show_console_banner = 0
cssfile = /web/glow.css
heap_size = 256

[android]
package = com.glow.encoretown

[ios]
bundle_identifier = com.glow.encoretown

[osx]
bundle_identifier = com.glow.encoretown
