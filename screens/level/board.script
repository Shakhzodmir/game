-- The level board (client-architecture.md, 4.1): owns the core game of the
-- level, runs it on a fixed step, draws it with pooled sprites and particle
-- bursts, turns touches into core commands and every core event into
-- animation, effects, sound and bus events for the HUD.
--
--   core game ....... client/level_session.lua (params -> core.new, fixed 1/60 s steps)
--   pieces .......... client/level_anim.lua (how each object looks) -> client/level_view.lua
--   effects ......... client/level_effects.lua (events -> commands) -> client/level_vfx.lua
--   input ........... client/level_input.lua (swipe / tap-tap / booster targets)
--   fixed things .... client/level_plates.lua (plates under blockers and wired pieces; the refusal of a move
--                     the core answers with not_movable shakes the thing, thuds and, once per session, explains)
--   hint ............ client/level_hint.lua (5 s idle -> game:hint() wobble)
--   sound ........... client/level_audio.lua (notes, effects, layers, haptics)
--   HUD / windows ... client/level_link.lua (plain calls) + the bus topics below
--   background ...... screens/level/level_bg.gui_script (sky, board backing, cells, floor)
--   overlay fx ...... screens/level/level_fx.gui_script (praise, combo titles, banners, confetti)
--   QA .............. client/level_qa.lua (hint_move, swap, tap, skip, win, state, ...)
--
-- Params (app.params): {level_id, run, level_text} from the start window
-- (client/flow.lua), or {level = n} for a standalone debug start (F2, the QA
-- "level n" command): then the level file is read here and no meta attempt
-- is involved.
--
-- Bus topics published here (client/bus.lua; payloads are read-only; lx, ly
-- are logical 720x1280 coordinates, y up; x, y are core cells, 1-based):
--   level_ready    {level_id, W, H, moves, goals, rect, standalone}   the board is built
--   level_moves    {left}                                              moves left changed
--   level_goal     {index, left, kind, color, item, x, y, lx, ly}      a goal went down
--                  (x, y, lx, ly = where the collected thing was: fly it to the goal icon)
--   level_score    {delta, total, lx, ly}                              points scored (lx, ly may be nil)
--   level_state    {state, reason}                                     playing | won_wait | concert |
--                  out_of_moves | lost | complete (reason "stuck" at out_of_moves)
--   level_praise   {word, index (1..5, i18n "praise.<index>"), wave}   a cascade word
--   level_banner   {key}                                               an i18n key, e.g. "hud.shuffle"
--   level_booster  {booster, phase = "target" | "cancel" | "used" | "rejected" | "done" | "pick", ok, reason, step}
--                  (pick: the Crossfader's first piece was picked, step 1, or let go, step 0)
--   level_result   {result = game:result()}                            complete or lost
--   level_special  {special, combo, lx, ly}                            a special fired (Bit scratches);
--                  combo = cross | triple_cross | bass_drop | bird_riff | bird_sub | trio | finale |
--                  color_riff | color_sub | color_bird, or nil
--   level_flash    {color, alpha, dur}                                 the whole screen flashes (fx GUI)
--   level_floor    {x, y, lx, ly}                                      a dance-floor tile was lit
--   level_noise    {x, y, lx, ly}                                      noise grew onto a piece (Bit covers his ears)
-- Bus topics read here: app_focus {focused} (the game stands still while the app is in the
-- background), settings_changed (through app.settings_rev).

local app = require("client.app")
local bus = require("client.bus")
local audio = require("client.audio")
local songs = require("client.songs")
local platform = require("client.platform")
local layout = require("client.layout")
local levels = require("client.levels")
local level_session = require("client.level_session")
local level_geom = require("client.level_geom")
local level_input = require("client.level_input")
local level_plates = require("client.level_plates")
local level_hint = require("client.level_hint")
local level_audio = require("client.level_audio")
local level_link = require("client.level_link")
local level_anim = require("client.level_anim")
local level_effects = require("client.level_effects")
local level_view = require("client.level_view")
local level_vfx = require("client.level_vfx")
local level_qa = require("client.level_qa")

local TOUCH = hash("touch")
local MAX_DT = 0.25       -- seconds of one frame that count at most
local SKIP_GUARD = 0.45   -- seconds after the win in which a tap does not skip the concert
local PIECES_REFRESH = 60 -- frames at most between two builds of the list of pieces of a board at rest
local REST_FRAMES = 20    -- frames of calm (nothing plays, the screen does not change) before the janitor looks
local REST_AGAIN = 600    -- frames at most between two looks of the janitor, when nothing has happened in between
local JANITOR_LOG = 5     -- passes with repairs that are written to the log (all are counted)

local function read_level(n)
	local info = levels.load(n)
	if info then return info.text end
	local ok, data = pcall(sys.load_resource, string.format("/content/levels/level_%04d.json", n))
	return ok and data or nil
end

local function safe_insets()
	local ok, sa = pcall(window.get_safe_area)
	return ok and type(sa) == "table" and sa or nil
end

local function settings()
	return app.meta and app.meta:settings() or {}
end

-- Cosmetic code must never stop the game: an error in the animations, effects or
-- sound is logged (the first few) and the frame goes on. Tests set self.strict
-- to see them.
local function guard(self, what, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		if self.strict then error(err, 0) end
		self.errors = (self.errors or 0) + 1
		if self.errors <= 5 then print("ERROR: level board (" .. what .. "): " .. tostring(err)) end
	end
	return ok
end

-- geometry for the current window
local function build_geom(self)
	local ww, wh = window.get_size()
	self.ww, self.wh = ww, wh
	self.fit = layout.fit(ww, wh)
	local area = layout.play_area(self.fit, { insets = safe_insets() })
	local g = level_geom.new(self.W, self.H, self.cells, area)
	self.geom = g
	self.anim:set_geom(g)
	self.effects:set_geom(g)
	self.vfx:set_geom(g)
	self.link_board.geom = g
	local v = self.link_board.view
	v.geom = g
	v.rev = v.rev + 1
	self.wires_dirty = true
end

local function refresh_cells(self)
	self.cells = self.session.game:cells()
	self.link_board.view.cells = self.cells
end

-- where the last collected thing was (a goal event has no position)
local SOURCE_EVENTS = { clear = true, destroy = true, floor_lit = true, mic_delivered = true, transform = true }

local function on_event(self, e)
	local ty = e.type
	if SOURCE_EVENTS[ty] then self.last_src = e end
	if ty == "moves" then
		bus.publish("level_moves", { left = e.left })
	elseif ty == "goal" then
		local src = self.last_src
		local goal = (self.session.data.goals or {})[e.index] or {}
		local p = { index = e.index, left = e.left, kind = goal.type, color = goal.color, item = goal.item }
		if src and src.x then
			p.x, p.y = src.x, src.y
			p.lx, p.ly = self.geom:center(src.x, src.y)
		end
		bus.publish("level_goal", p)
	elseif ty == "score" then
		local lx, ly
		if e.x then lx, ly = self.geom:center(e.x, e.y) end
		bus.publish("level_score", { delta = e.delta, total = e.total, lx = lx, ly = ly })
	elseif ty == "state" then
		bus.publish("level_state", { state = e.state, reason = e.reason })
		if e.state == "won_wait" then self.won_at = self.t end
		if e.state ~= "playing" then
			self.input:deselect()
			if e.state ~= "out_of_moves" and self.input.targeting then
				local id = self.input.targeting
				self.input:cancel_target()
				bus.publish("level_booster", { booster = id, phase = "cancel" })
			end
		end
		if e.state == "complete" or e.state == "lost" then
			bus.publish("level_result", { result = self.session.game:result() })
			-- the result window opens now and stops the session for good: what is still playing on the
			-- board (the tick effects follow the session) runs out by itself instead of freezing in place
			self.vfx:finish()
		end
	elseif ty == "hit" then
		if e.layer == "floor" then
			self.floor_dirty = true
		elseif e.layer == "wires" then
			self.wires_dirty = true
		end
	elseif ty == "floor_lit" then
		self.floor_dirty = true
		local v = self.link_board.view
		v.lit[(e.y - 1) * self.W + e.x] = self.t
		local lx, ly = self.geom:center(e.x, e.y)
		bus.publish("level_floor", { x = e.x, y = e.y, lx = lx, ly = ly })
	elseif ty == "freed" or ty == "shuffle" then
		self.wires_dirty = true
	elseif ty == "noise_spread" then
		local lx, ly = self.geom:center(e.x, e.y)
		bus.publish("level_noise", { x = e.x, y = e.y, lx = lx, ly = ly })
	elseif ty == "activate" then
		local lx, ly = self.geom:center(e.x, e.y)
		bus.publish("level_special", { special = e.special, combo = e.combo, lx = lx, ly = ly })
	elseif ty == "booster" then
		bus.publish("level_booster", { booster = e.booster, phase = "done", ok = e.ok })
	end
end

local function on_tick(self, events)
	local n = #events
	if n == 0 then return end
	local t = self.t
	for i = 1, n do
		local e = events[i]
		guard(self, "anim", self.anim.event, self.anim, e, t)
		guard(self, "effects", self.effects.event, self.effects, e)
		guard(self, "sound", self.laudio.event, self.laudio, e)
		guard(self, "event", on_event, self, e)
	end
	guard(self, "vfx", self.vfx.play, self.vfx, self.effects:drain())
end

-- commands ------------------------------------------------------------------------

local function command(self, cmd)
	local ok, res = self.session:command(cmd)
	self.status = self.session.status
	level_link.sent(cmd, ok, res) -- the tutorial hears what the core answered
	return ok, res
end

-- What is at core cell (x, y): the piece of game:pieces() (a column answers on all four of its cells) and what
-- keeps it in place for good ("blocker" | "wired", client/level_plates.lua), or nil.
local function fixed_at(self, x, y)
	local i = (y - 1) * self.W + x
	local p = self.cellmap[i]
	if not p then return nil end
	local c = self.cells and self.cells[i]
	return p, level_plates.kind(p, c ~= nil and (c.wires or 0) > 0)
end

-- The core refused a command (client/level_session.lua hooks.rejected, so the QA bridge gets the same). A swipe or
-- a tap on something that never moves comes back as not_movable: that thing shakes its head, thuds, and the
-- first time of each kind in a session a toast says how to get rid of it. Any other refusal of a swap (the
-- edge of the board, a piece still falling) keeps the small nudge of the piece that was touched.
local function on_rejected(self, cmd, why)
	if type(cmd) ~= "table" or (cmd.type ~= "swap" and cmd.type ~= "tap") then return end
	local first_kind, shook = nil, false
	if why == "not_movable" then
		for k = 1, 2 do
			local c = (k == 1) and (cmd.at or cmd.from) or cmd.to
			if type(c) == "table" and c[1] and c[2] then
				local p, kind = fixed_at(self, c[1], c[2])
				if kind then
					self.anim:nope(p.id, self.t)
					shook = true
					if not first_kind and level_plates.first(kind) then first_kind = kind end
				end
			end
		end
	end
	if shook then
		self.laudio:nope()
		if first_kind then app.toast_key(level_plates.TOAST[first_kind], nil, { color = "blue", duration = 3 }) end
	elseif cmd.type == "swap" and type(cmd.from) == "table" then
		local p = self.cellmap[(cmd.from[2] - 1) * self.W + cmd.from[1]]
		if p then self.anim:touch(p.id, self.t) end
	end
end

-- The Crossfader's picks (client/level_input.lua pick_pair): a click and a nudge for a piece taken, a shake and
-- the HUD's toast for one that cannot be moved.
local function pair_note(self, note)
	local p = self.cellmap[(note.y - 1) * self.W + note.x]
	if note.kind == "pick" or note.kind == "send" then
		if p then self.anim:touch(p.id, self.t) end
		self.laudio:touch()
	elseif note.kind == "refuse" then
		if p then self.anim:shake(p.id, self.t) end
		bus.publish("level_booster", { booster = "swap", phase = "rejected", reason = note.why })
	end
end

local function dispatch(self, cmd, note)
	if note then pair_note(self, note) end
	if not cmd then return end
	if not level_link.allow_command(cmd) then return end -- a tutorial step lets only its own move through
	if cmd.type == "swap" or cmd.type == "tap" then
		command(self, cmd) -- the core judges; a refusal comes back through on_rejected
	elseif cmd.type == "booster" then
		local ok, res = command(self, cmd)
		if ok then
			self.input:cancel_target()
			bus.publish("level_booster", { booster = cmd.booster, phase = "used" })
		else
			if cmd.to then
				local p = self.cellmap[(cmd.to[2] - 1) * self.W + cmd.to[1]]
				if p then self.anim:shake(p.id, self.t) end
			end
			bus.publish("level_booster", { booster = cmd.booster, phase = "rejected", reason = res })
		end
	end
end

-- logical coordinates of an input action
local function logical(self, action)
	-- window pixels, the same fit as the render script and client/ui.lua
	local f = self.fit or layout.fit(window.get_size())
	return layout.screen_to_logical(f, action.screen_x or action.x, action.screen_y or action.y)
end

local function board_point(self, lx, ly)
	local g = self.geom
	local x, y = g:cell_at(lx, ly)
	if x and g:exists(x, y) then
		local fx, fy = g:frac(lx, ly)
		return fx, fy, x, y
	end
	return nil
end

-- init / final ------------------------------------------------------------------

local function fail(self, err)
	print("ERROR: level board: " .. tostring(err))
	self.failed = true
	pcall(app.toast_key, "common.error", nil, { color = "pink" })
	app.show_screen("town", { from = "level" })
end

-- the app lost / regained the focus: the game stands still while it is away
local function on_focus(self, topic, p)
	if topic ~= "app_focus" or not self.session then return end
	if p.focused == false then
		self.session:set_hold(true)
		self.input:cancel()
	else
		self.session:set_hold(false)
		self.hint:touch()
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.t = 0
	self.janitor_frame = 0 -- (the frame of the janitor's last look)
	self.pairing = false -- the Crossfader's first piece is picked
	self.shake_x, self.shake_y = 0, 0
	self.vfx_errors = 0 -- effects that failed so far (the vfx frees them and goes on; see run_vfx)
	local params = app.params or {}
	local hooks = {
		first_move = function()
			if app.meta and app.meta:run() then
				app.meta:note_move()
				app.commit("first_move")
			end
		end,
		booster_used = function(id)
			if app.meta and app.meta:run() then
				local ok, why = app.meta:use_booster(id)
				if not ok then print("WARNING: level board: booster " .. id .. " not charged: " .. tostring(why)) end
				app.commit("booster")
			end
		end,
		rejected = function(cmd, why) guard(self, "refusal", on_rejected, self, cmd, why) end,
	}
	local s, err = level_session.new({ params = params, read_level = read_level, hooks = hooks })
	if not s then return fail(self, err) end
	self.session = s
	self.on_tick = function(events) on_tick(self, events) end
	self.on_focus = function(topic, p) on_focus(self, topic, p) end
	self.W, self.H = s.W, s.H
	self.status = s.game:status()
	local st = settings()
	local reduced = app.reduced_motion()
	self.reduced = reduced
	self.settings_rev = app.settings_rev

	self.cells = s.game:cells()
	-- starting floor: a tile that had hp and has none left is lit
	local floor0 = {}
	for i = 1, #self.cells do floor0[i] = self.cells[i].floor or 0 end
	local deliver = false
	for _, gl in ipairs(s.data.goals or {}) do
		if gl.type == "deliver" then deliver = true end
	end

	self.cellmap, self.by_id = {}, {}
	self.find_piece = function(id) return self.by_id[id] end -- (a closure made once, not per frame)
	self.input = level_input.new({ mode = st.input_mode, query = function(x, y)
		local p = self.cellmap[(y - 1) * self.W + x]
		if not p then return nil end
		local c = self.cells[(y - 1) * self.W + x]
		return { id = p.id, kind = p.kind, state = p.state, pinned = p.pinned, wired = c and (c.wires or 0) > 0 }
	end })
	self.hint = level_hint.new()
	self.plates = level_plates.new()
	self.anim = level_anim.new({ reduced = reduced })
	self.effects = level_effects.new({ reduced = reduced, lookup = function(id) return self.by_id[id] end })
	self.effects:set_cell_lookup(function(x, y) return self.cellmap[(y - 1) * self.W + x] end)
	self.view = level_view.new({ piece = "#piece_factory", glow = "#glow_factory" })
	self.vfx = level_vfx.new({
		piece = "#piece_factory", glow = "#glow_factory", reduced = reduced,
		on_gui = function(c)
			if c.kind == "praise" then
				bus.publish("level_praise", { word = c.word, index = c.index, wave = c.wave })
			elseif c.kind == "banner" then
				bus.publish("level_banner", { key = c.key })
			elseif c.kind == "screen_flash" then
				bus.publish("level_flash", { color = c.color, alpha = c.alpha, dur = c.dur })
			end
		end,
		on_slowmo = function(dur, scale) self.session:slowmo(dur, scale) end,
	})
	self.quality = level_vfx.quality()
	self.laudio = level_audio.new({ audio = audio, vibrate = platform.vibrate, now = function() return self.t end,
		width = self.W })
	self.focus_sub = bus.subscribe({ "app_focus" }, "level_board")

	self.link_board = {
		session = s, input = self.input, geom = nil,
		view = { rev = 0, floor_rev = 0, cells = self.cells, floor0 = floor0, lit = {}, deliver = deliver,
			shake_x = 0, shake_y = 0, W = self.W, H = self.H },
		on_booster = function(id, phase) bus.publish("level_booster", { booster = id, phase = phase }) end,
	}
	build_geom(self)
	level_link.attach(self.link_board)

	self.qa_off = level_qa.register({
		session = s,
		stats = function()
			local v, x = self.view:stats(), self.vfx:stats()
			return { view = v, vfx = x, plates = self.plates:count(), frames = self.frames or 0, ticks = s.ticks_run, dropped = s.dropped,
				janitor = { passes = self.janitor_passes or 0, repairs = self.janitor_repairs or 0 },
				selected = self.input.selected, pair = self.input.pair, targeting = self.input.targeting, errors = self.errors or 0,
				w = self.ww, h = self.wh, cell = self.geom and self.geom.cell, rect = self.geom and self.geom.rect,
				lite = self.vfx.lite }
		end,
		on_qa = function(name, res)
			-- the QA bridge runs in the main collection, where the id of an object of this one does not
			-- resolve (go.set_position: "Instance (null) not found"): the next update skips the show
			if name == "skip" and res and res.ok then self.clear_vfx = true end
		end,
	})

	songs.play("level", app.focus_district()) -- the pick of the jukebox, else the track of the district
	audio.level_duck(true)
	local d = s.data
	bus.publish("level_ready", { level_id = s.info.level_id, W = self.W, H = self.H, moves = d.moves,
		goals = d.goals, rect = level_link.board_rect(), standalone = s.info.standalone })
end

function final(self)
	if self.qa_off then self.qa_off() end
	if self.focus_sub then self.focus_sub:close() end
	level_link.detach(self.link_board)
	if self.laudio then self.laudio:finish() end
	audio.level_duck(false)
	if self.view then self.view:final() end
end

-- frame ---------------------------------------------------------------------------

-- A reusable mark table (no allocation per frame).
local function mark(self, i)
	local list = self.mark_pool
	if not list then
		list = {}
		self.mark_pool = list
	end
	local m = list[i]
	if not m then
		m = {}
		list[i] = m
	end
	return m
end

local function set_mark(m, image, x, y, w, h, color, alpha, z)
	m.image, m.x, m.y, m.w, m.h, m.color, m.alpha, m.z = image, x, y, w, h, color, alpha, z
	m.iw, m.ih, m.glow = nil, nil, true
	return m
end

local function marks(self)
	local list = self.mark_list or {}
	self.mark_list = list
	local n = 0
	local g = self.geom
	local cell = g.cell
	local sx, sy = self.shake_x, self.shake_y
	-- the plates under blockers and wired pieces go first: they keep the low slots of the pooled mark sprites
	n = self.plates:fill(list, n, self.pieces, self.cells, g, self.anim, self.t, sx, sy)
	local sel = self.input.selected or self.input.pair
	if sel then
		local x, y = g:center(sel.x, sel.y)
		n = n + 1
		list[n] = set_mark(mark(self, n), "fx_glow_dot", x + sx, y + sy, cell * 1.5, cell * 1.5, "#FFD84D", 0.85, nil)
		-- the gold glow vanishes on a lit (gold) dance-floor tile: a white ring keeps the selection visible there
		n = n + 1
		local ring = set_mark(mark(self, n), "fx_ring", x + sx, y + sy, cell * 1.08, cell * 1.08, "#FFFFFF", 0.95, nil)
		ring.iw, ring.ih = 128, 128 -- native size of fx_ring (client/level_vfx.lua M.IMG)
		list[n] = ring
	end
	local h = self.hint_cmd
	local phase = self.hint:phase()
	if h and phase then
		local a = math.sin(phase * math.pi)
		for k = 1, 2 do
			local c
			if h.at then c = (k == 1) and h.at or nil else c = (k == 1) and h.from or h.to end
			if c then
				local x, y = g:center(c[1], c[2])
				n = n + 1
				list[n] = set_mark(mark(self, n), "fx_glow_dot", x + sx, y + sy, cell * 1.4, cell * 1.4, "#FF7EB6",
					0.55 * a, nil)
			end
		end
	end
	local tg = self.input.targeting
	local hv = self.input.hover
	if tg and hv and g:inside(hv.x, hv.y) then
		local x, y = g:center(hv.x, hv.y)
		local w, hh = cell, cell
		if tg == "row_light" then
			x = (g.rect.x0 + g.rect.x1) / 2
			w = g.rect.x1 - g.rect.x0
		elseif tg == "col_light" then
			y = (g.rect.y0 + g.rect.y1) / 2
			hh = g.rect.y1 - g.rect.y0
		end
		n = n + 1
		local m = set_mark(mark(self, n), "white", x + sx, y + sy, w, hh, "#FFD84D", 0.38 + 0.12 * math.sin(self.t * 8), 0.25)
		m.iw, m.ih, m.glow = 8, 8, false
		list[n] = m
	end
	for i = #list, n + 1, -1 do list[i] = nil end
	self.view:marks(list)
end

local function follow_settings(self)
	if self.settings_rev == app.settings_rev then return end
	self.settings_rev = app.settings_rev
	local reduced = app.reduced_motion()
	self.anim:set_reduced(reduced)
	self.effects:set_reduced(reduced)
	self.vfx:set_reduced(reduced)
	self.input:set_mode(settings().input_mode)
end

-- the effects of this frame; the shake offset moves the pieces, the wires and the background
local function run_vfx(self, dt, tick_f)
	if self.clear_vfx then
		self.clear_vfx = nil
		self.vfx:skip()
	end
	self.shake_x, self.shake_y = self.vfx:update(dt, tick_f, self.t, self.session:halted())
	-- an effect that fails is freed by the vfx itself (and logged, the others go on); here it is counted, and in
	-- the tests (self.strict) it is raised after the frame
	local n = self.vfx.errors
	if n ~= self.vfx_errors then
		self.errors = (self.errors or 0) + n - self.vfx_errors
		self.vfx_errors = n
		if self.strict then error(self.vfx.last_error, 0) end
	end
end

-- What the board remembers of a piece or a cell is compared with a fresh look at the core by the janitor.
local PIECE_FIELDS = { "id", "x", "y", "kind", "state", "offx", "offy", "hidden", "pinned", "color", "special", "axis", "item", "hp" }
local CELL_FIELDS = { "exists", "wires", "floor" }

local function same_list(a, b, fields)
	if not a or #a ~= #b then return false end
	for i = 1, #b do
		local x, y = a[i], b[i]
		for k = 1, #fields do
			local f = fields[k]
			if x[f] ~= y[f] then return false end
		end
	end
	return true
end

-- The janitor. The board has been calm for REST_FRAMES frames (the core at rest, the session running, no effect, no
-- change on the screen), so the screen must show exactly the core's board and nothing else. Everything else in this
-- script trusts what it has sent to the engine; this asks the ENGINE (client/level_view.lua audit_sprite) and puts right
-- what differs: an effect sprite nobody holds or that is drawn although it is pooled, the sprite of a piece the core no
-- longer has, a piece, a mark or a wire that is not where it was put, a wires overlay that is not the core's, and the
-- lists the board keeps between two frames (pieces, cells). Every repair is counted (view and vfx stats().repaired,
-- janitor_repairs) and the first few passes with repairs are logged: it finds nothing on a healthy board, so a repair
-- is news. It runs once per calm; a pass reads about one position per sprite and writes only to repair, and it builds
-- game:pieces() and game:cells() once, like the refresh of the list of pieces every second.
local function janitor(self)
	local game = self.session.game
	local pieces, cells = game:pieces(), game:cells()
	local ids = self.janitor_ids
	if not ids then
		ids = {}
		self.janitor_ids = ids
	end
	for k in pairs(ids) do ids[k] = nil end -- order-independent
	for i = 1, #pieces do ids[pieces[i].id] = true end
	local fixed = self.vfx:audit() + self.view:audit(ids, cells, self.geom)
	if not same_list(self.pieces, pieces, PIECE_FIELDS) then
		self.pieces = nil -- (built again by the next frame)
		fixed = fixed + 1
	end
	if not same_list(self.cells, cells, CELL_FIELDS) then
		self.wires_dirty, self.floor_dirty = true, true
		fixed = fixed + 1
	end
	self.janitor_passes = (self.janitor_passes or 0) + 1
	if fixed > 0 then
		self.janitor_repairs = (self.janitor_repairs or 0) + fixed
		self.janitor_logged = (self.janitor_logged or 0) + 1
		if self.janitor_logged <= JANITOR_LOG then
			print("WARNING: level janitor: put right " .. fixed .. " thing(s) of a board at rest")
		end
	end
	return fixed
end

local function run_pieces(self, pieces, tick_f)
	local list = self.anim:frame(pieces, tick_f, self.t)
	self.view:sync(list, self.shake_x, self.shake_y)
end

function update(self, dt)
	if not self.session or self.failed then return end
	if dt > MAX_DT then dt = MAX_DT end
	self.t = self.t + dt
	self.frames = (self.frames or 0) + 1
	follow_settings(self)
	self.focus_sub:drain(self.on_focus)
	local ww, wh = window.get_size()
	if ww ~= self.ww or wh ~= self.wh then build_geom(self) end
	local lite = self.quality:frame(dt)
	if lite ~= self.vfx.lite then self.vfx:set_lite(lite) end

	local s = self.session
	if s.auto then
		local sent = s:autoplay_step()
		if sent then self.hint:touch() end
	end
	s:advance(dt, self.on_tick)
	self.status = s.status
	local game = s.game
	local playing = self.status.state == "playing"
	local stable = game:is_stable()

	-- pieces of this frame: by cell (input, rays) and by id (selection, debris colours). game:pieces() makes a
	-- table per piece (40-70 KB of garbage a frame), so the list is built again only when the board can look
	-- different: it is in motion (now, or it was when the list was built), an event or a command came since
	-- (s.rev), and now and then for good measure. A board at rest is the same board.
	local pieces = self.pieces
	if not pieces or not stable or not self.pieces_still or self.pieces_rev ~= s.rev or self.pieces_age >= PIECES_REFRESH then
		pieces = game:pieces()
		self.pieces, self.pieces_still, self.pieces_rev, self.pieces_age = pieces, stable, s.rev, 0
		local cellmap, by_id = self.cellmap, self.by_id
		for k in pairs(cellmap) do cellmap[k] = nil end -- order-independent
		for k in pairs(by_id) do by_id[k] = nil end -- order-independent
		for i = 1, #pieces do
			local p = pieces[i]
			local k = (p.y - 1) * self.W + p.x
			cellmap[k] = p
			by_id[p.id] = p
			if p.item == "column" then -- one object on four cells: a finger on any of them is on the column
				cellmap[k + 1], cellmap[k + self.W], cellmap[k + self.W + 1] = p, p, p
			end
		end
	else
		self.pieces_age = self.pieces_age + 1
	end
	self.input:validate(self.find_piece, playing)
	local pairing = self.input.pair ~= nil
	if pairing ~= self.pairing then
		-- the Crossfader's first piece was picked / let go / lost: the HUD's prompt follows
		self.pairing = pairing
		bus.publish("level_booster", { booster = "swap", phase = "pick", step = pairing and 1 or 0 })
	end
	if not self.intro_done then
		self.intro_done = true
		self.anim:intro(pieces, self.t)
	end

	if self.wires_dirty or self.floor_dirty then
		refresh_cells(self)
		if self.floor_dirty then
			local v = self.link_board.view
			v.floor_rev = v.floor_rev + 1
		end
		if self.wires_dirty then self.view:set_wires(self.cells, self.geom) end
		self.wires_dirty, self.floor_dirty = false, false
	end

	-- hint after 5 s without touches
	local allowed = playing and not self.input.selected and not self.input.targeting and not s:halted()
		and not s.auto and stable
	if self.hint:update(dt, allowed) then self.hint_cmd = level_link.hint(s:hint_command()) end
	local phase = self.hint:phase()
	local h = self.hint_cmd
	if phase and h then
		if h.at then self.anim:hint(h.at, h.at, phase) else self.anim:hint(h.from, h.to, phase) end
	else
		self.anim:hint(nil)
	end
	local picked = self.input.selected or self.input.pair
	self.anim:select(picked and picked.id or nil)

	local tick_f = s:display_tick()
	guard(self, "vfx update", run_vfx, self, dt, tick_f)
	local v = self.link_board.view
	v.shake_x, v.shake_y = self.shake_x, self.shake_y
	guard(self, "pieces", run_pieces, self, pieces, tick_f)
	guard(self, "marks", marks, self)
	-- Calm: the core is at rest, the session runs, no skip waits, no effect plays or waits, and not a single call went
	-- to the engine since the last frame (a touch, the hint, a pulse, a shake all write every frame). A few comparisons
	-- a frame, nothing allocated. The janitor looks once the calm has lasted REST_FRAMES, if anything has happened since
	-- its last look (a core event or command, an effect), and anyway every REST_AGAIN frames.
	if stable and not s:halted() and not self.clear_vfx and self.vfx:idle() and level_view.writes == self.rest_writes then
		local n = (self.rest_frames or 0) + 1
		self.rest_frames = n
		if n >= REST_FRAMES and (s.rev ~= self.janitor_rev or self.vfx.played ~= self.janitor_played
			or self.frames - self.janitor_frame >= REST_AGAIN) then
			self.janitor_rev, self.janitor_played, self.janitor_frame = s.rev, self.vfx.played, self.frames
			guard(self, "janitor", janitor, self)
		end
	else
		self.rest_frames = 0
	end
	self.rest_writes = level_view.writes -- (the repairs of the janitor are not a change: the next calm looks again)
end

function on_input(self, action_id, action)
	if action_id ~= TOUCH or not self.session or self.failed then return false end
	local s = self.session
	if s:halted() then return false end
	local st = self.status and self.status.state
	local lx, ly = logical(self, action)
	if action.pressed then
		self.hint:touch()
		self.hint_cmd = nil
		if st == "won_wait" or st == "concert" then
			-- a tap during the final concert skips it (not the one that made the last move)
			if self.won_at and self.t - self.won_at < SKIP_GUARD then return true end
			local ok = command(self, { type = "skip" })
			if ok then self.vfx:skip() end
			return true
		end
		local targeting = self.input.targeting
		if st ~= "playing" and not (targeting and st == "out_of_moves") then return false end
		local fx, fy, x, y = board_point(self, lx, ly)
		if fx and not level_link.allow_cell(x, y) then return true end -- tutorial: only the guided cells
		self.input:press(fx, fy)
		if fx then
			local p, fixed = fixed_at(self, x, y)
			-- a piece swells and clicks under the finger; a blocker or a wired piece stays dead until it is
			-- swiped or tapped (then it shakes its head: on_rejected)
			if p and not fixed and not targeting then
				self.anim:touch(p.id, self.t)
				self.laudio:touch()
			end
			return true
		end
		return false
	elseif action.released then
		local fx, fy = board_point(self, lx, ly)
		local cmd, note = self.input:release(fx, fy)
		dispatch(self, cmd, note)
		return fx ~= nil
	else
		local g = self.geom
		local fx, fy = g:frac(lx, ly)
		local cmd = self.input:move(fx, fy)
		if cmd then dispatch(self, cmd) end
		return self.input.pressed ~= nil
	end
end
