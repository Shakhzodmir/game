-- Level background, drawn UNDER the board sprites (material gui_under, see
-- render/glow.render_script): the sky and the level picture continued past
-- the design area, the bunting, and the board itself: the white frame
-- (rectangular boards) or the edge tiles of shaped boards (one tile per grid
-- vertex, tools/art/gen_art.py board_backing), the checker cells, the dance
-- floor tiles (violet while unlit, gold when lit, a stage in between for a
-- two-layer tile: client/level_floor.lua; updated as they are hit) and the
-- microphone stands under the exits, and the carpet (core-rules 10.8,
-- client/level_carpet.lua): a tile over every covered cell, unrolled with a
-- pop when the core covers one more; and the conveyor belts (core-rules
-- 10.9, client/level_conveyor.lua): one tile a belt cell, turned the way the
-- belt moves; and the portals (core-rules 10.14, client/level_portal.lua):
-- the picture of the entrance or the exit on its cell and the mark of the
-- pair. Pieces, wires and effects are world
-- sprites drawn on top by screens/level/board.script.
--
-- The board publishes what to draw through client/level_link.lua (view):
-- rev (layout), floor_rev (a tile changed), the shake offset every frame.

local app = require("client.app")
local ui = require("client.ui")
local assets = require("client.assets")
local link = require("client.level_link")
local level_floor = require("client.level_floor")
local level_carpet = require("client.level_carpet")
local level_conveyor = require("client.level_conveyor")
local level_portal = require("client.level_portal")
local level_sky = require("client.level_sky")
local packs = require("client.packs")

local GUI = "/screens/level/level_bg.gui"
local FRAME_PAD = 20 -- board/board_frame: 14 px frame + 6 px backing around the cells

local function shaped(g)
	for i = 1, g.W * g.H do
		if not g.ex[i] then return true end
	end
	return false
end

local function rebuild(self, v)
	local s = self.ui
	if self.l_board then s:clear(self.l_board) end
	self.l_board = s:layer(self.c_board, "board")
	local parent = self.l_board
	local g = v.geom
	local cell = g.cell
	local r = g.rect
	self.tiles, self.tile_key = {}, {}
	if shaped(g) then
		for _, t in ipairs(g:edge_tiles()) do
			local n = s:image(parent, "board/edge_" .. t.kind, t.lx, t.ly, { w = cell, h = cell })
			if n and t.turns ~= 0 then gui.set_euler(n, vmath.vector3(0, 0, -90 * t.turns)) end
		end
	else
		local w, h = r.x1 - r.x0 + 2 * FRAME_PAD, r.y1 - r.y0 + 2 * FRAME_PAD
		local frame = s:image(parent, "board/board_frame", (r.x0 + r.x1) / 2, (r.y0 + r.y1) / 2,
			{ w = w, h = h, slice9 = true })
		if not frame then s:round(parent, (r.x0 + r.x1) / 2, (r.y0 + r.y1) / 2, w, h, "white", { alpha = 0.6 }) end
	end
	local cells = v.cells or {}
	for y = 1, g.H do
		for x = 1, g.W do
			local i = (y - 1) * g.W + x
			if g.ex[i] then
				local lx, ly = g:center(x, y)
				local key
				if (v.floor0[i] or 0) > 0 then
					key = level_floor.image(v.floor0[i], cells[i] and cells[i].floor or 0)
				else
					key = ((x + y) % 2 == 0) and "board/cell_a" or "board/cell_b"
				end
				local n = s:image(parent, key, lx, ly, { w = cell, h = cell })
				if not n then
					n = s:box(parent, lx, ly, cell, cell, { color = ((x + y) % 2 == 0) and "white" or "lavender", alpha = 0.95 })
				end
				self.tiles[i] = n
				self.tile_key[i] = key
			end
		end
	end
	if v.deliver then
		for _, e in ipairs(g:exits()) do
			s:image(parent, "blockers/mic_stand", e.lx, e.ly - cell * 0.15, { w = cell, h = cell * 0.6 })
		end
	end
	-- the carpet: one tile for every cell of a carpet level, made once (over the cell tiles, under the pieces)
	-- and shown when the core covers the cell, so a covered cell never adds a node
	self.rugs, self.rug_on = {}, {}
	if v.carpet then
		local side = level_carpet.size(cell)
		for y = 1, g.H do
			for x = 1, g.W do
				local i = (y - 1) * g.W + x
				if g.ex[i] then
					local lx, ly = g:center(x, y)
					local n = s:image(parent, level_carpet.IMAGE, lx, ly, { w = side, h = side })
					if n then
						local on = cells[i] ~= nil and cells[i].carpet == true
						gui.set_enabled(n, on)
						self.rugs[i] = n
						self.rug_on[i] = on
					end
				end
			end
		end
	end
	-- the conveyor belts: a tile on every belt cell, arrows turned the way the belt moves (over the cell tile,
	-- the floor and the carpet; under the pieces). The belts are level data: made once, never changed
	self.belts = {}
	for _, b in ipairs(level_conveyor.tiles(cells)) do
		if g.ex[b.i] then
			local x = (b.i - 1) % g.W + 1
			local y = (b.i - x) / g.W + 1
			local lx, ly = g:center(x, y)
			local n = s:image(parent, level_conveyor.IMAGE, lx, ly, { w = cell, h = cell })
			if n then
				if b.turn ~= 0 then gui.set_euler(n, vmath.vector3(0, 0, b.turn)) end
				self.belts[#self.belts + 1] = n
			end
		end
	end
	-- the portals: the picture of its role on every portal cell and the mark of its pair in the corner (over
	-- the cell tile, the floor and the carpet; under the pieces). Level data: made once, never changed
	self.portals, self.portal_marks = {}, {}
	for _, p in ipairs(level_portal.tiles(cells)) do
		if g.ex[p.i] then
			local x = (p.i - 1) % g.W + 1
			local y = (p.i - x) / g.W + 1
			local lx, ly = g:center(x, y)
			local col = vmath.vector4(p.color[1], p.color[2], p.color[3], 1)
			local n = s:image(parent, p.image, lx, ly, { w = cell, h = cell, color = level_portal.TINT and col or nil })
			if n then self.portals[#self.portals + 1] = n end
			local side = cell * level_portal.MARK_SIZE
			local m = s:image(parent, level_portal.MARK, lx + cell * level_portal.MARK_AT[1], ly + cell * level_portal.MARK_AT[2],
				{ w = side, h = side, color = col })
			if m then self.portal_marks[#self.portal_marks + 1] = m end
		end
	end
	self.rev = v.rev
	self.floor_rev = v.floor_rev
end

-- Floor tiles follow the core: violet (two layers / one) -> violet with a gold core (a two-layer tile after its
-- first hit) -> gold, each change with a pop (smaller for the first layer of two).
local ONE = vmath.vector3(1, 1, 1)

-- The carpet follows the core: a cell that got covered shows its tile, unrolled from small to its size.
local function update_carpet(self, v, cells, calm)
	for i, n in pairs(self.rugs) do -- order-independent
		local on = cells[i] ~= nil and cells[i].carpet == true
		if on ~= self.rug_on[i] then
			self.rug_on[i] = on
			gui.set_enabled(n, on)
			gui.cancel_animations(n, "scale")
			if on and not calm then
				local pop = level_carpet.POP
				gui.set_scale(n, vmath.vector3(pop.from, pop.from, 1))
				gui.animate(n, "scale", ONE, gui.EASING_OUTBACK, pop.time)
			else
				gui.set_scale(n, ONE)
			end
		end
	end
end

local function update_floor(self, v)
	self.floor_rev = v.floor_rev
	local cells = v.cells or {}
	local calm = app.reduced_motion()
	update_carpet(self, v, cells, calm)
	for i, n in pairs(self.tiles) do -- order-independent
		local start = v.floor0[i] or 0
		if start > 0 then
			local hp = cells[i] and cells[i].floor or 0
			local key = level_floor.image(start, hp)
			if key ~= self.tile_key[i] then
				self.tile_key[i] = key
				local e = assets.image(key)
				if e and e.anim then gui.play_flipbook(n, e.anim) end
				local pop = level_floor.pop(level_floor.stage(start, hp))
				if pop and not calm then
					gui.cancel_animations(n, "scale")
					gui.set_scale(n, vmath.vector3(pop.scale, pop.scale, 1))
					gui.animate(n, "scale", ONE, gui.EASING_OUTBACK, pop.time)
				end
			end
		end
	end
end

-- The level being played: the board knows it first, the screen's params before that.
local function level_now()
	local info = link.info()
	if info and info.level_id then return info.level_id end
	local p = app.params or {}
	return p.level_id or p.level
end

-- The backdrop and the living sky of the level's district (client/level_sky.lua): the district's own picture
-- or the common one, with clouds drifting or stars twinkling over it. Built again when the level is known.
local function apply_theme(self, level)
	local s = self.ui
	local district = level_sky.district_of(app.district_list, level)
	local key, own = assets.level_bg_key(district)
	self.waiting_bg = nil
	if own and not s:loose_texture(key) then
		-- the web build has not downloaded the district's picture yet (client/packs.lua; loose_texture asked for
		-- it): the common backdrop, as for a district without a picture of its own, until it arrives (update)
		self.waiting_bg = key
		key, own = assets.level_bg_key(nil)
	end
	local kind = level_sky.kind(district, own)
	local id = key .. "|" .. kind .. "|" .. (district or "")
	self.level_seen = level
	if self.theme_id == id then return end
	self.theme_id = id
	if self.l_theme then s:clear(self.l_theme) end
	self.l_theme = s:layer(self.c_theme, "theme")
	s:backdrop(self.l_theme, key)
	s:release_images({ [key] = true }) -- the common backdrop leaves the GPU when the district's own came
	self.sky_nodes, self.sky_t = {}, 0
	for _, it in ipairs(level_sky.items(kind, district or "")) do
		local n = s:image(self.l_theme, it.key, it.x, it.y, { w = it.w, h = it.h, alpha = it.alpha })
		if n then self.sky_nodes[#self.sky_nodes + 1] = { node = n, item = it } end
	end
	self.sky_drawn = false
end

-- The sky moves a little; with reduced motion it is drawn once and stands still.
local function update_sky(self, dt)
	local nodes = self.sky_nodes
	if not nodes or #nodes == 0 then return end
	local reduced = app.reduced_motion()
	if reduced and self.sky_drawn then return end
	self.sky_drawn = reduced
	self.sky_t = (self.sky_t or 0) + dt
	for _, e in ipairs(nodes) do
		local x, y, a, sc = level_sky.pose(e.item, self.sky_t, reduced)
		gui.set_position(e.node, vmath.vector3(x, y, 0))
		gui.set_color(e.node, vmath.vector4(1, 1, 1, a))
		gui.set_scale(e.node, vmath.vector3(sc, sc, 1))
	end
end

function init(self)
	self.ui = ui.scene({ gui = GUI, on_resize = function() self.dirty = true end })
	local s = self.ui
	s:sky({ clouds = false })
	self.c_theme = s:layer(s.root, "theme_root")
	apply_theme(self, level_now())
	local bunting = s:image(s.root, "ui/bunting", 360, 1280 - 34, { w = 760, h = 68 })
	if bunting then s:anchor(bunting, "top") end
	self.c_board = s:layer(s.root, "board_root")
	self.rev = -1
	self.floor_rev = -1
	self.shake = vmath.vector3()
end

function final(self)
	self.ui:final()
end

function update(self, dt)
	self.ui:update(dt)
	local level = level_now()
	if level and level ~= self.level_seen then
		apply_theme(self, level)
	elseif self.waiting_bg and packs.version ~= self.packs_seen then
		self.packs_seen = packs.version
		if packs.bytes(self.waiting_bg) then apply_theme(self, self.level_seen) end -- the district's picture came
	end
	update_sky(self, dt)
	local v = link.view()
	if not v or not v.geom then return end
	if v.rev ~= self.rev or self.dirty then
		self.dirty = false
		rebuild(self, v)
	elseif v.floor_rev ~= self.floor_rev then
		update_floor(self, v)
	end
	local sh = self.shake
	if sh.x ~= v.shake_x or sh.y ~= v.shake_y then
		sh.x, sh.y = v.shake_x, v.shake_y
		gui.set_position(self.c_board, sh)
	end
end
