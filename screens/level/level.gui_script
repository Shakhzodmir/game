-- Level (placeholder until the board and HUD are built on top of core/):
-- level background, "Level N", an empty board frame of the right size, the
-- booster bar slots and a back button. Music is ducked -6 dB while here.
--
-- The board rectangle comes from client/layout.lua with the device
-- safe-area insets (the HUD is anchored to the safe top, the booster bar to
-- the safe bottom), and is laid out again when the window size changes.
-- The HUD is rebuilt when the language changes.

local app = require("client.app")
local ui = require("client.ui")
local i18n = require("client.i18n")
local bus = require("client.bus")
local audio = require("client.audio")
local layout = require("client.layout")
local assets = require("client.assets")

local GUI = "/screens/level/level.gui"
local BOOSTERS = { "stick", "row_light", "col_light", "remix" }

local function level_data(n)
	local data = sys.load_resource(string.format("/content/levels/level_%04d.json", n))
	if not data then return nil end
	local ok, lvl = pcall(json.decode, data)
	return ok and type(lvl) == "table" and lvl or nil
end

local function board_size(lvl)
	if lvl and type(lvl.cells) == "table" and #lvl.cells > 0 then
		local rows = #lvl.cells
		local cols = type(lvl.cells[1]) == "string" and #lvl.cells[1] or (type(lvl.cells[1]) == "table" and #lvl.cells[1]) or 9
		return cols, rows
	end
	return 9, 9
end

-- The board rectangle for the current window (logical coordinates).
local function board_rect(self)
	local s = self.ui
	local cols, rows = board_size(self.lvl)
	return layout.board(cols, rows, layout.play_area(s.fit, { insets = s.insets }))
end

local function build_board(self)
	local s = self.ui
	if self.l_board then s:clear(self.l_board) end
	self.l_board = s:layer(s.root, "board")
	if self.l_hud then gui.move_below(self.l_board, self.l_hud) end
	local parent = self.l_board
	local b = board_rect(self)
	self.board = b
	local pad = 20
	local frame = s:image(parent, "board/board_frame", b.cx, b.cy, { w = b.width + 2 * pad, h = b.height + 2 * pad, slice9 = true })
	if not frame then
		s:round(parent, b.cx, b.cy, b.width + 2 * pad, b.height + 2 * pad, "white", { alpha = 0.6 })
	end
	for row = 0, b.rows - 1 do
		for col = 0, b.cols - 1 do
			local x, y = layout.cell_center(b, col, row)
			local key = ((row + col) % 2 == 0) and "board/cell_a" or "board/cell_b"
			if not s:image(parent, key, x, y, { w = b.cell, h = b.cell }) then
				s:box(parent, x, y, b.cell, b.cell, { color = ((row + col) % 2 == 0) and "white" or "lavender", alpha = 0.95 })
			end
		end
	end
	-- a few pieces as a preview of the art (static, not the game)
	local colors = { "red", "orange", "yellow", "green", "blue", "purple" }
	for i = 0, b.cols - 1 do
		local x, y = layout.cell_center(b, i, b.rows - 1)
		local p = s:image(parent, "pieces/" .. colors[(i % #colors) + 1], x, y, { w = b.cell * 0.96, h = b.cell * 0.96 })
		if p and not self.board_built then ui.pop_in(p, 0.03 * i, 0.3) end
	end
	local note = s:round(parent, b.cx, b.cy, math.min(b.width - 40, 520), 110, "white", { alpha = 0.92 })
	s:text(note, i18n.t("hud.placeholder"), 0, 0, { font = "button", size = 34, color = "text", max_width = 480 })
	self.board_built = true
end

local function build_hud(self)
	local s = self.ui
	if self.l_hud then s:clear(self.l_hud) end
	self.l_hud = s:layer(s.root, "hud")
	local parent = self.l_hud
	local top = 1280 - 120
	local back = s:button({ parent = parent, x = 80, y = top, w = 110, h = 110, style = "blue", icon = "ui/icons/home", icon_size = 72,
		text = not assets.has_image("ui/icons/home") and "<" or nil,
		on_click = function() self.leave(self) end })
	s:anchor(back.node, "top")
	local title = s:text(parent, i18n.t("hud.level", { n = self.level }), 360, top + 8, {
		font = "title", size = 64, color = "white", outline = "#FF4D8D", shadow = "shadow", max_width = 420,
	})
	s:anchor(title, "top")
	if self.lvl and self.lvl.difficulty and self.lvl.difficulty ~= "easy" and self.lvl.difficulty ~= "medium" then
		local sub = s:text(parent, i18n.t(self.lvl.difficulty == "hard" and "town.hard" or "town.super_hard"), 360, top - 50, {
			font = "button", size = 30, color = "pink", outline = "white",
		})
		s:anchor(sub, "top")
	end
	local moves = s:image(parent, "ui/moves_badge", 640, top, { w = 120, h = 120, slice9 = true })
	if not moves then moves = s:circle(parent, 640, top, 110, "pink") end
	s:anchor(moves, "top")
	s:text(moves, self.lvl and self.lvl.moves and tostring(self.lvl.moves) or "–", 0, 4, {
		font = "title", size = 50, color = "white", outline = "#A8204F",
	})
	s:text(moves, i18n.t("hud.moves"), 0, -72, { font = "button", size = 26, color = "white", outline = "#A8204F", max_width = 150 })

	-- booster bar
	local bar = s:round(parent, 360, 100, 680, 150, "white", { alpha = 0.9 })
	s:anchor(bar, "bottom")
	for i, id in ipairs(BOOSTERS) do
		local x = -255 + (i - 1) * 170
		local slot = s:round(bar, x, 0, 132, 124, "lavender")
		local icon = s:image(slot, "ui/icons/" .. id, 0, 4, { w = 88, h = 88 })
		if icon then gui.set_color(icon, vmath.vector4(1, 1, 1, 0.5)) end
		local lock = s:image(slot, "ui/icons/lock", 40, -38, { w = 48, h = 48 })
		if not lock then s:circle(slot, 40, -38, 30, "text_soft") end
	end
end

local function leave(self)
	if self.left then return end
	self.left = true
	app.show_screen("town", { from = "level" })
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.level = tonumber(app.params.level) or app.meta:level_to_play() or 1
	self.lvl = level_data(self.level)
	self.leave = leave
	self.sub = bus.subscribe({ "language_changed" }, "level")
	self.on_bus = function(topic) if topic == "language_changed" then self.dirty_hud = true end end
	local s = ui.scene({ gui = GUI, on_resize = function() self.dirty_board = true end })
	self.ui = s
	s:sky({ clouds = false })
	s:backdrop(s.root, "backgrounds/level_bg")
	local bunting = s:image(s.root, "ui/bunting", 360, 1280 - 30, { w = 760, h = 68 })
	if bunting then s:anchor(bunting, "top") end
	build_board(self)
	build_hud(self)
	audio.music(app.focus_district())
	audio.level_duck(true)
end

function final(self)
	self.sub:close()
	audio.level_duck(false)
	self.ui:final()
end

function update(self, dt)
	self.sub:drain(self.on_bus)
	self.ui:update(dt) -- may flag dirty_board through on_resize
	if self.dirty_hud then
		self.dirty_hud = false
		build_hud(self)
		self.dirty_board = true -- texts on the board too
	end
	if self.dirty_board then
		self.dirty_board = false
		build_board(self)
	end
end

function on_input(self, action_id, action)
	if action_id == hash("back") and action.released then
		leave(self)
		return true
	end
	return self.ui:on_input(action_id, action)
end
