-- Level HUD and level windows (client-architecture.md, 4.2), over the board of screens/level/board.script.
--
-- This script is glue: what is drawn lives in screens/level/hud.lua (the top row, the booster bar, Bit,
-- the flights to the goals, the score pops) and screens/level/tutorial_view.lua (spotlight, hand,
-- bubble); where things stand and what they do in client/level_hud.lua, client/level_bit.lua and
-- client/tutorial.lua (pure, tested); what the windows say in client/level_windows.lua; how an attempt
-- ends in client/level_end.lua (through the meta: client/flow.lua and the meta API own the rules). The
-- windows (gui/pause.lua, moves.lua, defeat.lua, result.lua, booster_buy.lua, and the meta's start, lives,
-- shop, settings, confirm) are hosted by client/popups.lua over everything.
--
-- The board talks to this script through the bus topics listed in screens/level/board.script and
-- client/level_link.lua; this script talks to the board through that module.
--   level_ready   build the HUD and Bit, start the tutorial of the level (if it has one and it was not seen)
--   level_moves / level_goal / level_score / level_special / level_noise / level_praise   the HUD, Bit
--   level_state   out_of_moves -> the offer window; the booster bar follows the state
--   level_result  complete -> finish the attempt (meta) and show the results; lost -> the defeat
--   level_booster target mode on / off, the booster used
--
-- Flow of the end: win -> results -> "Next level" opens the start window of the next level -> Play (three taps
-- from the win with the skip of the concert); defeat -> "Try again" opens the start window of the same level ->
-- Play (two taps). Pause -> leave: before the first move the attempt is dropped, after it a loss that the town
-- shows. A level started without a meta attempt (debug keys, the QA "level n" command) plays with free boosters
-- and free "+5 moves" and gets stand-in results.
-- State for QA / debug: app.ui.level (the HUD) and app.ui.popup (client/popups.lua).

local app = require("client.app")
local ui = require("client.ui")
local i18n = require("client.i18n")
local bus = require("client.bus")
local audio = require("client.audio")
local fx_mod = require("client.fx")
local bit = require("client.bit")
local popups = require("client.popups")
local link = require("client.level_link")
local level_hud = require("client.level_hud")
local level_windows = require("client.level_windows")
local level_end = require("client.level_end")
local tutorial = require("client.tutorial")
local ads = require("client.services.ads")
local analytics = require("client.services.analytics")
local hud_mod = require("screens.level.hud")
local tutorial_view = require("screens.level.tutorial_view")

local GUI = "/screens/level/level.gui"
local TOUCH = hash("touch")
local BACK = hash("back")

-- literal requires: bob bundles only modules it can see
local REGISTRY = {
	pause = require("gui.pause"),
	moves = require("gui.moves"),
	defeat = require("gui.defeat"),
	result = require("gui.result"),
	booster_buy = require("gui.booster_buy"),
	start = require("gui.start"),
	lives = require("gui.lives"),
	shop = require("gui.shop"),
	settings = require("gui.settings"),
	confirm = require("gui.confirm"),
}

local Level = {}
Level.__index = Level

-- Cosmetic code must never stop the level: an error is logged (the first few) and the frame goes on.
local function guard(self, what, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		self.errors = (self.errors or 0) + 1
		if self.errors <= 5 then print("ERROR: level HUD (" .. what .. "): " .. tostring(err)) end
	end
	return ok
end

-- windows ------------------------------------------------------------------------------------------------------

function Level:open(name, params)
	return self.popups:open(name, params)
end

-- the board stands still while a window is open; the tutorial hides
function Level:on_popups()
	local open = self.popups:count() > 0
	if open ~= self.paused then
		self.paused = open
		link.pause(open)
		self.tutv:set_visible(not open)
	end
end

function Level:go_town(delay)
	self.leave_in = delay or 0
end

-- Pause only while the level is being played: once the last goal is down the win is certain, and a leave
-- from the finale would be booked as a loss.
local PAUSABLE = { playing = true, out_of_moves = true }

function Level:open_pause()
	if self.ended or not self.ctx or self.popups:count() > 0 or not PAUSABLE[self.state] then return end
	self:open("pause", {
		view = level_windows.pause(app.meta, app.now()), level_id = self.ctx.level_id,
		on_close = function(result) if result == "leave" then self:leave() end end,
	})
end

-- pause -> leave: the attempt is dropped (before the first move) or lost (after it), then the town
function Level:leave()
	if self.ended then return end
	self.ended = true
	link.cancel_booster()
	level_end.quit(self.ctx)
	self:go_town(0)
end

function Level:moves_view()
	local st = link.status() or {}
	return level_windows.out_of_moves(app.meta, { state = st.state, stuck = st.stuck, goals = st.goals }, app.now(),
		{ ads = ads.can_show("continue"), boosters = level_hud.BOOSTERS })
end

function Level:open_moves()
	if self.ended or not self.ctx or self.popups:find("moves") then return end
	local st = link.status()
	if not st or st.state ~= "out_of_moves" then return end -- it has moved on since the event
	local view = self:moves_view()
	level_end.offer_shown(view.offer, self.ctx)
	if view.ad then ads.offer_shown("continue") end -- once per opening: the window rebuilds itself on a language change
	self:open("moves", {
		view = view, ctx = self.ctx, refresh = function() return self:moves_view() end,
		on_close = function(r) self:on_moves_close(r) end,
	})
end

function Level:on_moves_close(r)
	if type(r) ~= "table" then return end
	if r.action == "continue" then
		link.continue(r.moves, r.riff)
	elseif r.action == "ad" then
		link.continue(r.moves, false)
	elseif r.action == "booster" then
		-- the window is gone: if the booster could not start (the board is still moving, nothing to shuffle...) the
		-- player is not left without the offer, the moves to buy and the way to give up
		if not self:on_booster(r.id) and self.state == "out_of_moves" and not self.ended then self:open_moves() end
	elseif r.action == "give_up" then
		link.give_up()
	end
end

-- The windows that need what only the game knows (a view, a booster) get a sensible default when a QA
-- request names none; returns false for one that cannot be made up (the results, the defeat).
function Level:fill_params(name, params)
	if name == "moves" then
		if not params.view then
			if not self.ctx then return false end
			params.view, params.ctx = self:moves_view(), self.ctx
			params.refresh = function() return self:moves_view() end
		end
	elseif name == "booster_buy" then
		params.id = params.id or "stick"
	elseif name == "defeat" or name == "result" then
		if not params.view then return false end
	end
	return true
end

function Level:open_buy(id)
	self:open("booster_buy", { id = id, on_close = function(r)
		if type(r) == "table" and r.action == "bought" then self:on_booster(r.id) end
	end })
end

-- the end of the attempt ----------------------------------------------------------------------------------------

function Level:fail_end()
	app.toast_key("common.error", nil, { color = "pink" })
	self:go_town(1.0)
end

function Level:on_result(result)
	if self.ended or not self.ctx then return end
	self.ended = true
	link.cancel_booster()
	self.hud:set_target(nil)
	if self.tutorial then
		self.tutorial:update(0) -- it hears the end of the level
	end
	if result.won then
		local res = level_end.win(result, self.ctx)
		if not res then return self:fail_end() end
		local view = level_windows.result(app.meta, res, result, app.now())
		self:open("result", {
			view = view, refund = res.refund, standalone = res.standalone,
			on_close = function(r)
				if r == "town" then
					self:go_town(0)
				elseif type(r) == "table" and r.action == "next" then
					app.show_screen("level", { level = r.level, from = "level" })
				end
			end,
		})
	else
		local res = level_end.lose(result, self.ctx)
		if not res then return self:fail_end() end
		audio.sfx("lose")
		local st = link.status() or {}
		local view = level_windows.defeat(app.meta, res, st, self.hud.goal_defs, self.hud.goals and self.hud.goals.total, app.now())
		self:open("defeat", {
			view = view, level_id = self.ctx.level_id, standalone = res.standalone,
			on_close = function(r)
				if r == "town" then
					if not res.standalone then app.push_reward(res) end -- the town shows the life and the streak
					self:go_town(0)
				elseif type(r) == "table" and r.action == "retry" then
					app.show_screen("level", { level = self.ctx.level_id, from = "level" })
				end
			end,
		})
	end
end

-- boosters -----------------------------------------------------------------------------------------------------------

function Level:cancel_booster()
	link.cancel_booster()
end

-- A tap on a booster (the bar, or the out-of-moves window). Returns true when the booster is going on: target
-- mode is on, it was applied, or a purchase window took over; false when nothing started (a tutorial step does
-- not allow it, it is locked, the board is moving, the core refused it) or it was cancelled.
function Level:on_booster(id)
	if self.ended or not self.ctx or self.popups:count() > 0 then return false end
	local st = link.status() or {}
	local info = hud_mod.booster_info(id)
	local bs = level_hud.booster_state(info)
	local act = level_hud.booster_tap(id, bs, {
		state = st.state, targeting = link.targeting(), allowed = link.allow_booster(id),
	})
	if act == "blocked" then
		self.tutv:shake()
	elseif act == "cancel" then
		link.cancel_booster()
	elseif act == "locked" then
		app.toast_key("hud.booster_locked", { n = info.unlock_level or "?" }, { color = "blue" })
	elseif act == "buy" then
		self:open_buy(id)
		return true
	elseif act == "wait" then
		app.toast_key("hud.wait_board", nil, { color = "blue" })
	else
		if link.targeting() then link.cancel_booster() end
		local ok, why = link.booster(id)
		if not ok and why ~= "busy" then
			app.toast_key(level_hud.refusal_key(why), nil, { color = "blue" })
		end
		return ok and true or false
	end
	return false
end

function Level:on_booster_event(p)
	if p.phase == "target" then
		self.hud:set_target(p.booster)
	elseif p.phase == "cancel" or p.phase == "used" then
		self.hud:set_target(nil)
		-- aimed at nothing while the moves are out: the offer is back
		if p.phase == "cancel" and self.state == "out_of_moves" and not self.ended then self:open_moves() end
	elseif p.phase == "rejected" then
		app.toast_key(level_hud.refusal_key(p.reason), nil, { color = "blue" })
	elseif p.phase == "done" then
		if p.ok ~= false then level_end.booster_used(self.ctx, p.booster) end
		self.hud:refresh_boosters()
	end
end

-- the tutorial -----------------------------------------------------------------------------------------------------------

function Level:start_tutorial(info)
	if not app.meta then return end
	local ok, t = pcall(tutorial.start, info.level_id, {
		seen = function(id) return app.meta:tutorial_seen(id) end,
		mark = function(id)
			app.meta:mark_tutorial_seen(id)
			app.commit("tutorial")
		end,
		on_step = function(i)
			pcall(analytics.log, "tutorial_step", { id = tutorial.id(info.level_id) .. ":" .. i, level = info.level_id })
		end,
		env = {
			state = function() local st = link.status() return st and st.state or nil end,
			stable = link.stable, can_swap = link.can_swap, piece = link.piece, specials = link.specials,
			hint = link.core_hint, targeting = link.targeting,
			moves_left = function() local st = link.status() return st and st.moves_left or nil end,
			booster_ready = function(id)
				local b = hud_mod.booster_info(id)
				return b.unlocked and (b.count == nil or b.count > 0)
			end,
			mode = function() return app.meta:settings().input_mode end,
		},
	})
	if not ok then
		print("WARNING: level HUD: tutorial: " .. tostring(t))
		return
	end
	if t then
		self.tutorial = t
		link.set_guard(t:guard())
	end
end

function Level:stop_tutorial()
	if self.tutorial then
		self.tutorial = nil
		link.clear_guard()
		self.tutv:set(nil)
	end
end

function Level:skip_tutorial()
	if self.tutorial then self.tutorial:skip() end
end

function Level:update_tutorial(dt)
	local t = self.tutorial
	if not t then return end
	t:update(dt)
	if t:finished() then
		self:stop_tutorial()
		return
	end
	local rect = link.board_rect()
	self.tutv:set(t:view(), rect)
	if t.blocked ~= self.blocked_seen then
		self.blocked_seen = t.blocked
		self.tutv:shake()
	end
	self.tutv:update(dt)
end

-- the board's events ------------------------------------------------------------------------------------------------------

function Level:on_ready()
	local info, st = link.info(), link.status()
	if not info or not st then return end
	self.state = st.state
	self.ctx = { level_id = info.level_id, t0 = app.now(), standalone = info.standalone }
	self.moves0, self.moved = st.moves_left, false
	self.hud:build(info, st, link.board_rect())
	self.hud:start_bit(st.state, st.moves_left)
	self.dirty = false
	self:stop_tutorial()
	self:start_tutorial(info)
end

function Level:on_state(p)
	self.state = p.state
	self.hud:set_state(p.state)
	guard(self, "bit", self.hud.bit_event, self.hud, "level_state", p)
	if p.state == "out_of_moves" then
		self:open_moves()
	else
		local e = self.popups:find("moves")
		if e then e:close("auto") end -- the moves came back (a debug command, a booster that solved it)
	end
end

function Level:on_bus(topic, p)
	self.popups:on_event(topic, p)
	if topic == "level_ready" then
		self:on_ready()
	elseif topic == "level_moves" then
		self.hud:set_moves(p.left)
		guard(self, "bit", self.hud.bit_event, self.hud, topic, p)
		if self.ctx and not self.moved and self.moves0 and p.left < self.moves0 then
			self.moved = true
			level_end.first_move(self.ctx)
		end
	elseif topic == "level_goal" then
		guard(self, "goal", self.hud.on_goal, self.hud, p)
		guard(self, "bit", self.hud.bit_event, self.hud, topic, p)
	elseif topic == "level_score" then
		self.hud:on_score(p)
	elseif topic == "level_state" then
		self:on_state(p)
	elseif topic == "level_result" then
		self:on_result(p.result or {})
	elseif topic == "level_booster" then
		self:on_booster_event(p)
	elseif topic == "level_special" or topic == "level_noise" or topic == "level_praise" then
		guard(self, "bit", self.hud.bit_event, self.hud, topic, p)
	elseif topic == "meta_changed" then
		self.hud:refresh_boosters()
	elseif topic == "language_changed" then
		self.dirty = true
	elseif topic == "settings_changed" then
		self.hud:set_reduced(app.reduced_motion())
	elseif topic == "screen_leaving" then
		self.leaving = true
		self.popups:close_all()
	elseif topic == "popup_request" then
		-- app.open_popup / app.close_popup (QA, debug): any window of the registry
		if p.close then
			self.popups:close()
		elseif p.name and REGISTRY[p.name] and not self.ended then
			local params = p.params or {}
			if p.name == "start" then params.level = params.level or (app.meta and app.meta:level_to_play()) end
			if self:fill_params(p.name, params) then self:open(p.name, params) end
		end
	end
end

-- frame ----------------------------------------------------------------------------------------------------------------------

function Level:publish()
	local u = app.ui
	u.screen = "level"
	-- one table, refilled every frame (no garbage)
	local l = self.pub
	if not l then
		l = {}
		self.pub = l
	end
	local g = self.hud.goals
	l.state, l.moves, l.low, l.goals = self.state, self.hud.moves, self.hud.moves_low or false, g and g.shown or nil
	l.targeting, l.bit, l.ended, l.errors = link.targeting(), self.hud.bit and self.hud.bit.mood or nil, self.ended or false, self.errors or 0
	local t = self.tutorial
	if t then
		local tt = l.tutorial or {}
		tt.index, tt.phase, tt.blocked = t.index, t.phase, t.blocked
		l.tutorial = tt
	else
		l.tutorial = nil
	end
	-- where to tap (logical coordinates, for the QA bridge): the pause button and the four boosters; rebuilt only
	-- when the HUD was laid out again
	local layout = self.hud.l
	if layout and layout ~= self.pub_layout then
		self.pub_layout = layout
		local tg = {}
		tg.pause = { x = layout.pause.cx, y = layout.pause.cy }
		for _, id in ipairs(level_hud.BOOSTERS) do
			local r = self.hud:booster_rect(id)
			if r then tg[id] = { x = r.cx, y = r.cy } end
		end
		self.pub_targets = tg
	end
	l.targets = self.pub_targets
	u.level = l
end

function Level:update(dt)
	self.ui:update(dt)
	self.sub:drain(self.bus_cb)
	if link.active() then
		if not self.ctx then
			self:on_ready() -- the board came up after this script
		elseif self.dirty then
			self.dirty = false
			self.hud:build(link.info(), link.status(), link.board_rect())
		else
			self.hud:follow_board(link.board_rect())
		end
	end
	guard(self, "hud", self.hud.update, self.hud, dt)
	self.fx:update(dt)
	self.popups:update(dt)
	guard(self, "tutorial", self.update_tutorial, self, dt)
	if self.leave_in then
		self.leave_in = self.leave_in - dt
		if self.leave_in <= 0 then
			self.leave_in = nil
			app.show_screen("town", { from = "level" })
		end
	end
	self:publish()
end

function Level:on_input(action_id, action)
	if self.popups:on_input(action_id, action) then return true end
	if action_id == BACK then
		if action.released then self:open_pause() end
		return true
	end
	if action_id ~= TOUCH then return false end
	if self.swallow then
		if action.released then self.swallow = false end
		return true
	end
	if self.ui:on_input(action_id, action) then return true end
	if action.pressed then
		local t = self.tutorial
		local v = t and t:view()
		if v and v.dismiss == "tap" then
			-- a tip: this tap is the one that dismisses it (and does not reach the board)
			t:tap()
			self.swallow = not action.released
			return true
		end
		if self.hud:pick_bit(action) then
			self.swallow = not action.released
			return true
		end
	end
	return false
end

local function new_level()
	local t = setmetatable({}, Level)
	t.ui = ui.scene({ gui = GUI, on_resize = function() t.dirty = true end })
	app.ui = { screen = "level" }
	t.c_hud = t.ui:layer(t.ui.root, "hud_root")
	t.c_tut = t.ui:layer(t.ui.root, "tutorial_root")
	t.c_popups = t.ui:layer(t.ui.root, "popups_root")
	t.fx = fx_mod.new(t.ui, t.ui.root)
	t.hud = hud_mod.new(t.ui, {
		fx = t.fx, layer = t.c_hud,
		actions = {
			pause = function() t:open_pause() end,
			booster = function(id) t:on_booster(id) end,
			cancel_booster = function() t:cancel_booster() end,
		},
	})
	t.tutv = tutorial_view.new(t.ui, { parent = t.c_tut, fx = t.fx, hud = t.hud, on_skip = function() t:skip_tutorial() end })
	t.popups = popups.new(t.ui, t.c_popups, {
		registry = REGISTRY, fx = t.fx,
		release = function() t.ui:release_images(bit.images()) end,
		on_change = function() t:on_popups() end,
	})
	t.sub = bus.subscribe({
		"level_ready", "level_moves", "level_goal", "level_score", "level_state", "level_result", "level_booster",
		"level_special", "level_noise", "level_praise", "meta_changed", "language_changed", "settings_changed",
		"screen_leaving", "lives_tick", "popup_request",
	}, "level_hud")
	t.bus_cb = function(topic, p) t:on_bus(topic, p) end
	t.state, t.dirty, t.paused, t.ended = "playing", false, false, false
	return t
end

function init(self)
	msg.post(".", "acquire_input_focus")
	gui.set_render_order(2)
	self.l = new_level()
	-- the board may be ready already (its init ran first): build at once
	if link.active() and link.info() then self.l:on_ready() end
end

function final(self)
	local t = self.l
	link.clear_guard()
	t.sub:close()
	t.popups:close_all()
	t.ui:final()
	app.ui = {}
end

function update(self, dt)
	self.l:update(dt)
end

function on_input(self, action_id, action)
	return self.l:on_input(action_id, action)
end
