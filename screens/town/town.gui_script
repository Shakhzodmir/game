-- Town: the main meta screen (client-architecture.md, section 6).
--
-- Layers, bottom to top (fixed containers keep the draw order; their
-- content is rebuilt on its own):
--   scene  - sky, district background (+ edge extension), the task items
--            (screens/town/scene.lua): restored = full colour, gold glow,
--            idle bob; not restored = <task>_ghost.png. Rebuilt when the
--            district or the view (day / concert) changes; a finished task
--            only redraws its item.
--   bit    - Bit next to the task card (anchored to the safe bottom)
--   ui     - top bar, ribbon, task card, "Level N", navigation (screens/town/hud.lua)
--   popups - the meta windows (client/popups.lua + gui/*.lua)
--   fx     - flights, bursts, confetti (client/fx.lua), above everything
--
-- What happens is queued in a show (screens/town/show.lua, steps in
-- screens/town/steps.lua): a task being built, the rewards brought back from
-- a level (client/rewards.lua, app.push_reward), the district concert, a
-- chest, the next district. The counters show town.disp = meta - queued
-- rewards - town.hold (paid but not landed yet), so nothing is counted twice; the lives pill likewise
-- leaves out the unlimited lives of a chest that has not opened yet (hud.lua lives_view).
-- The district on display (town.district) can differ from the one being built (town.focus): the
-- player pages through the open districts with the ribbon arrows or a swipe on the scene; the
-- card then offers the way back, and the track of the district on display plays.
-- Bus in: meta_changed, lives_tick, language_changed, settings_changed,
-- save_reset, screen_leaving, popup_request (app.open_popup), reward_pushed,
-- meta_qa (client/meta_qa.lua).

local app = require("client.app")
local ui = require("client.ui")
local i18n = require("client.i18n")
local bus = require("client.bus")
local audio = require("client.audio")
local fx = require("client.fx")
local bit = require("client.bit")
local views = require("client.views")
local rewards = require("client.rewards")
local popups = require("client.popups")
local flow = require("client.flow")
local analytics = require("client.services.analytics")
local scene_mod = require("screens.town.scene")
local hud_mod = require("screens.town.hud")
local show_mod = require("screens.town.show")
local steps = require("screens.town.steps")

local GUI = "/screens/town/town.gui"
local TOUCH = hash("touch")

-- literal requires: bob bundles only modules it can see
local REGISTRY = {
	start = require("gui.start"),
	lives = require("gui.lives"),
	shop = require("gui.shop"),
	settings = require("gui.settings"),
	jukebox = require("gui.jukebox"),
	concert = require("gui.concert"),
	chest = require("gui.chest"),
	gift = require("gui.gift"),
	confirm = require("gui.confirm"),
}

local NOTE_COLORS = { "red", "orange", "yellow", "green", "blue", "purple" }
local SWIPE_MIN = 90   -- logical px of a horizontal swipe that pages the districts
local TAP_SLOP = 26    -- a press and release further apart than this is a drag, not a tap

local Town = {}
Town.__index = Town

-- counters -----------------------------------------------------------------------------------

function Town:sync_disp()
	local held = rewards.held()
	self.disp.coins = app.meta:coins() - held.coins - self.hold.coins
	self.disp.stars = app.meta:stars() - held.stars - self.hold.stars
	self.hud:set_coins(self.disp.coins)
	self.hud:set_stars(self.disp.stars)
	-- the status for QA follows at once (publish() writes the rest)
	app.ui.disp = { coins = self.disp.coins, stars = self.disp.stars }
	app.ui.hold = { coins = self.hold.coins, stars = self.hold.stars, infinite = self.hold.infinite }
end

function Town:publish()
	local u = app.ui
	u.screen = "town"
	u.district = self.district
	u.focus = self.focus
	u.sliding = self.sliding
	local nav = self.hud and self.hud.paging
	u.nav = nav and { count = nav.count, index = nav.index, prev = nav.prev, next = nav.next } or nil
	u.hint = self.hud and self.hud.hint and self.hud.hint.id or nil
	u.card = self.hud and self.hud.card_kind or nil
	u.view = self.scene and self.scene.view or nil
	u.busy = self.show:busy()
	u.step = self.show:name()
	u.steps_started = self.show.started
	u.disp = { coins = self.disp.coins, stars = self.disp.stars }
	u.hold = { coins = self.hold.coins, stars = self.hold.stars, infinite = self.hold.infinite }
	u.targets = self.hud.targets
	u.bit = self.bit and self.bit.mood or nil
end

-- Loose images to keep in GPU memory: this district (and one sliding out),
-- Bit, and the concert background while the concert is open.
function Town:keep_images()
	local keep = self.scene:keep({})
	for k in pairs(bit.images()) do keep[k] = true end -- order-free: a set
	local c = self.popups and self.popups:find("concert")
	if c then REGISTRY.concert.images(c.params.district or self.district, keep) end
	return keep
end

-- popups ----------------------------------------------------------------------------------------

function Town:open_popup(name, params)
	params = params or {}
	if self.sliding then return nil end
	if name == "start" then
		params.level = params.level or app.meta:level_to_play()
		if not params.level then
			app.toast_key("town.all_done", nil, { color = "blue" })
			return nil
		end
	elseif name == "concert" then
		params.district = params.district or self.district
	elseif name == "chest" and not params.chest then
		-- QA: a sample chest to look at (nothing is paid)
		params.kind = params.kind or "level"
		params.chest = { coins = 60, boosters = { "stick" }, infinite_minutes = 15 }
	elseif name == "gift" then
		params.id = params.id or "riff"
	end
	return self.popups:open(name, params)
end

-- actions -----------------------------------------------------------------------------------------

function Town:toggle_view()
	if self.show:busy() or self.sliding then return end
	local view = app.meta:view(self.district)
	local ok = app.meta:set_view(self.district, view == "day" and "concert" or "day")
	app.commit("view")
	if not ok then return end
	audio.sfx("button")
	self.fx:flash(360, 760, { size = 1500, dur = 0.45, color = view == "day" and "#C9A7FF" or "#FFF4C9" })
	self.scene:build(self.district)
	self.hud:build()
	self:publish()
end

-- district switching -------------------------------------------------------------------------------

function Town:can_browse()
	return not self.show:busy() and self.popups:count() == 0 and not self.sliding and not self.leaving
end

-- Pages to the previous (dir = -1) or the next (dir = 1) open district.
function Town:browse(dir)
	if not self:can_browse() then return false end
	local nav = views.browse(app.meta, self.district)
	local target = dir < 0 and nav.prev or nav.next
	if not target then
		audio.sfx("swap_fail") -- the end of the street
		return false
	end
	return self:browse_to(target, dir)
end

-- Shows the open district `id`: it slides in (from the side it lies on), its track plays, the
-- ribbon and the card follow. dir: 1 = it lies to the right of the one on display.
function Town:browse_to(id, dir)
	if not self:can_browse() or id == self.district then return false end
	local nav = views.browse(app.meta, self.district)
	local from, to
	for i, did in ipairs(nav.ids) do
		if did == self.district then from = i end
		if did == id then to = i end
	end
	if not to then return false end -- not open (yet)
	dir = dir or ((to > (from or 1)) and 1 or -1)
	self.sliding = true
	self.district = id
	audio.sfx("button")
	audio.music(id)
	self.hud:build()
	self.scene:slide_to(id, function()
		self.sliding = false
		self:publish()
	end, dir)
	self.bit:cheer(1.2, 1)
	self:publish()
	return true
end

-- True while a button is pressed (and the press is not stale: a lost release must not freeze the bars).
function Town:finger_down()
	if not self.ui.pressed then
		self.press_age = 0
		return false
	end
	return (self.press_age or 0) < 1
end

-- A tap on the task card (or the QA command / a tap on the item of the task).
function Town:on_task(shown)
	if self.show:busy() or self.sliding then return end
	local task = views.task(app.meta)
	if not task or (shown and task.id ~= shown.id) then
		self.hud:build()
		return
	end
	if not task.affordable then
		audio.sfx("swap_fail")
		if self.hud.card then self.fx:shake(self.hud.card, 14, 0.45) end
		self.bit:worry()
		app.toast_key("town.task_need", { n = task.need }, { color = "pink" })
		if self.hud.level_btn then
			self.fx:after(0.35, function() if self.hud.level_btn then self.fx:pop(self.hud.level_btn, 0.08, 0.35) end end)
		end
		return
	end
	local res, why = app.meta:complete_task(task.district, task.id)
	if res then app.meta:mark_tutorial_seen(views.HINT_TASK) end -- the hint did its job
	app.commit("task")
	if not res then
		app.toast_key(why == "not_enough_stars" and "common.not_enough_stars" or "common.error", nil, { color = "pink" })
		self.hud:build()
		return
	end
	-- the stars stay in the top bar until they fly to the card
	self.hold.stars = self.hold.stars - task.cost
	if res.chest then self.hold.coins = self.hold.coins + (res.chest.coins or 0) end
	self:sync_disp()
	self.show:push(steps.task(self, task, res))
	if res.district_complete then
		self.show:push(steps.concert(self, res))
		if res.chest then
			self.show:push(steps.chest(self, { kind = "district", chest = res.chest, district = res.district },
				{ coins = res.chest.coins or 0, stars = 0 }))
		end
		self.show:push(steps.next_district(self, res.next_district))
	end
	self:publish()
end

function Town:on_nav(item, node)
	if item.id == "town" then
		if node then self.fx:pop(node, 0.12, 0.3) end
		self.bit:cheer(1.2, 1)
		return
	end
	if item.soon then
		if node then self.fx:shake(node, 10, 0.35) end
		app.toast_key("toast.coming_soon", nil, { color = "blue" })
		return
	end
	self:open_popup(item.id, item.id == "shop" and { tab = "boosters" } or nil)
end

-- A tap on the scene: a restored item plays a note, a waiting one says so.
function Town:tap_scene(action)
	local lx, ly = self.ui:logical(action)
	if self.sliding then return false end
	local id, e = self.scene:item_at(lx, ly)
	if not id then return false end
	local task = views.task(app.meta)
	if e.done then
		self.fx:pop(e.node, 0.12, 0.35)
		self.fx:burst(lx, ly, { count = 6, radius = 60, size = 24 })
		self.note_i = (self.note_i or 0) % 6 + 1
		audio.play_note(NOTE_COLORS[self.note_i], ((self.note_i * 3) % 7) + 1, { quantize = true })
	elseif task and task.id == id and task.district == self.district and task.affordable then
		self:on_task(task)
	else
		self.fx:shake(e.node, 8, 0.35)
		local name
		for _, t in ipairs(app.meta:district(self.district).tasks) do
			if t.id == id then name = t.name end
		end
		app.toast_key("town.item_wait", { item = name or id }, { color = "blue" })
	end
	return true
end

-- rewards ------------------------------------------------------------------------------------------

function Town:queue_rewards()
	while rewards.count() > 0 do
		local r = rewards.pop()
		for _, step in ipairs(steps.rewards(self, r)) do self.show:push(step) end
	end
	self:sync_disp()
	self:publish()
end

-- The level chests the player won and has not opened yet (the results window offers the chest first; a player
-- who went on without opening it gets it here). The meta pays a chest when the player takes it, so nothing
-- is held beforehand.
function Town:queue_pending_chests()
	for _, w in ipairs(app.meta:pending_chests()) do
		local id = w.level_id
		self.show:push(steps.chest(self, {
			kind = "level", chest = w.chest, level_id = id,
			claim = function() return app.claim_level_chest(id) end,
		}))
	end
	self:publish()
end

-- lifecycle ------------------------------------------------------------------------------------------

local function on_bus(self, topic, p)
	if self.popups then self.popups:on_event(topic, p) end
	if topic == "language_changed" then
		self.dirty_ui = true
	elseif topic == "settings_changed" then
		if p and (p.key == "reduced_motion" or p.key == "*") then self.dirty_scene, self.dirty_ui = true, true end
	elseif topic == "meta_changed" then
		self.dirty_ui = true
	elseif topic == "lives_tick" then
		if not self.show:busy() then self.hud:tick() end
	elseif topic == "save_reset" then
		self.popups:close_all()
		self.show:clear()
		self.fx:clear()
		self.hold.coins, self.hold.stars, self.hold.infinite = 0, 0, 0
		self.dirty_scene, self.dirty_ui = true, true
	elseif topic == "screen_leaving" then
		self.leaving = true
		self.popups:close_all()
		self.show:clear()
	elseif topic == "popup_request" then
		if p.close then
			self.popups:close()
		elseif p.name then
			self:open_popup(p.name, p.params)
		end
	elseif topic == "reward_pushed" then
		self:queue_rewards()
	elseif topic == "meta_qa" then
		if p.action == "task" then
			self:on_task(nil)
		elseif p.action == "skip" then
			self.show:skip()
		elseif p.action == "browse" then
			if p.id then self:browse_to(p.id) else self:browse(p.dir or 1) end
		elseif p.action == "view" then
			if p.view and p.view ~= app.meta:view(self.district) then self:toggle_view() end
		end
	end
end

-- The town object (Defold's `self` is userdata: it cannot take a
-- metatable, so the screen lives in a plain table at self.t).
local function new_town()
	local t = setmetatable({}, Town)
	t.sub = bus.subscribe({ "meta_changed", "lives_tick", "language_changed", "settings_changed", "save_reset",
		"screen_leaving", "popup_request", "reward_pushed", "meta_qa" }, "town")
	t.on_bus = function(topic, p) on_bus(t, topic, p) end
	t.ui = ui.scene({ gui = GUI })
	t.disp = { coins = 0, stars = 0 }
	t.hold = { coins = 0, stars = 0, infinite = 0 } -- paid, not landed yet (infinite: seconds of unlimited lives)
	app.ui = { screen = "town" }

	-- an attempt a level left open is settled first (its loss is shown)
	local stale = flow.settle_stale_run()
	if stale then app.push_reward(stale) end

	t.c_scene = t.ui:layer(t.ui.root, "scene")
	t.c_bit = t.ui:layer(t.ui.root, "bit")
	t.ui:anchor(t.c_bit, "bottom")
	t.c_ui = t.ui:layer(t.ui.root, "ui")
	t.c_popups = t.ui:layer(t.ui.root, "popups_root")
	t.fx = fx.new(t.ui, t.ui.root)

	t.focus = app.focus_district()
	t.district = t.focus
	t.sliding = false
	t.scene = scene_mod.new(t)
	t.hud = hud_mod.new(t)
	t.show = show_mod.new(t)
	t.popups = popups.new(t.ui, t.c_popups, {
		registry = REGISTRY, fx = t.fx,
		release = function() t.ui:release_images(t:keep_images()) end,
		on_change = function() t:publish() end,
	})
	t.bit = bit.new(t.ui, t.c_bit, hud_mod.BIT_X, hud_mod.BIT_Y, 136)

	t.scene:build(t.district)
	t.hud:build()
	t:sync_disp()

	audio.level_duck(false)
	audio.layer("tension", false)
	audio.layer("party", false)
	audio.music(t.district)

	t.enter_t = 0
	t.twinkle_t = 0
	-- a window asked for with the screen (QA: client/meta_qa.lua "open" from another screen)
	local want = app.params and app.params.open
	if type(want) == "string" then t.pending_open = { name = want, params = app.params.open_params } end
	t:publish()
	return t
end

function Town:update(dt)
	self.sub:drain(self.on_bus)
	self.enter_t = self.enter_t + dt
	-- rewards brought back from a level play after the fade-in
	if self.enter_t > 0.45 and not self.rewards_started then
		self.rewards_started = true
		if rewards.count() > 0 then self:queue_rewards() end
		self:queue_pending_chests()
	end
	if self.pending_open and self.enter_t > 0.5 and not self.show:busy() then
		local want = self.pending_open
		self.pending_open = nil
		self:open_popup(want.name, want.params)
	end
	if not self.show:busy() then
		if self.hold.coins ~= 0 or self.hold.stars ~= 0 or self.hold.infinite ~= 0 then
			if self.hold.infinite ~= 0 then self.dirty_ui = true end -- the lives pill shows them from now on
			self.hold.coins, self.hold.stars, self.hold.infinite = 0, 0, 0
			self:sync_disp()
		end
		-- the district being built changed (a reset, the next district opened elsewhere)
		local focus = app.focus_district()
		if focus ~= self.focus then
			self.focus = focus
			self.district = focus
			self.dirty_scene, self.dirty_ui = true, true
			audio.music(focus)
		end
		if self.dirty_scene then
			self.dirty_scene = false
			self.scene:build(self.district)
		end
		-- (not while a finger is down on a button: a rebuild would delete it and lose the tap)
		if self.dirty_ui and not self:finger_down() then
			self.dirty_ui = false
			self.hud:build()
			self:sync_disp()
			self:publish()
		end
	end
	self.show:update()
	if self.ui.pressed then self.press_age = (self.press_age or 0) + dt end
	self.popups:update(dt)
	self.fx:update(dt)
	self.bit:update(dt)
	self.ui:update(dt)
	-- the scene twinkles now and then
	self.twinkle_t = self.twinkle_t + dt
	if self.twinkle_t > 1.4 then
		self.twinkle_t = 0
		if not fx.reduced() and self.popups:count() == 0 and not self.show:busy() then self.scene:twinkle(self.fx) end
	end
	app.ui.busy = self.show:busy()
	app.ui.step = self.show:name()
end

function Town:on_input(action_id, action)
	if self.popups:on_input(action_id, action) then return true end
	if action_id == TOUCH and action.pressed and self.show:skippable() then
		self.show:skip()
		self.swallow = true
		return true
	end
	if self.swallow then
		if action.released then self.swallow = false end
		return true
	end
	if self.show:busy() then
		-- the HUD waits for the show (a chest's coins still flying)
		return action_id == TOUCH
	end
	if action_id == TOUCH and action.pressed and self.bit:pick(action) then
		self.bit:poke()
		self.swallow = true
		return true
	end
	if self.ui:on_input(action_id, action) then return true end
	if action_id == TOUCH and action.pressed then
		self.press_x, self.press_y = self.ui:logical(action)
	elseif action_id == TOUCH and action.released then
		local px, py = self.press_x, self.press_y
		self.press_x, self.press_y = nil, nil
		if px then
			local lx, ly = self.ui:logical(action)
			local dx, dy = lx - px, ly - py
			if math.abs(dx) >= SWIPE_MIN and math.abs(dx) > 1.6 * math.abs(dy) then
				self:browse(dx < 0 and 1 or -1) -- a swipe left shows the next district
				return true
			end
			if dx * dx + dy * dy > TAP_SLOP * TAP_SLOP then return false end -- a drag, not a tap
		end
		return self:tap_scene(action)
	end
	return false
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.t = new_town()
end

function final(self)
	local t = self.t
	t.sub:close()
	t.popups:close_all()
	t.show:clear()
	app.ui = {}
	t.ui:final()
end

function update(self, dt)
	self.t:update(dt)
end

function on_input(self, action_id, action)
	return self.t:on_input(action_id, action)
end
