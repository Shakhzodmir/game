-- Loader / splash (placeholder art): logo for 1.5 s, then the town, or level 1
-- straight away on the first launch (client-architecture.md, 3).

local app = require("client.app")
local ui = require("client.ui")
local i18n = require("client.i18n")

local DURATION = 1.5

local function notices()
	local info = app.load_info or {}
	if info.source == "previous" then app.toast(i18n.t("splash.restored"), { color = "gold" }) end
	if info.interrupted == "loss" then app.toast(i18n.t("splash.interrupted"), { color = "pink" }) end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	local s = ui.scene({ gui = "/screens/splash/splash.gui" })
	self.ui = s
	s:sky()

	-- sun glow behind the logo
	local glow = s:circle(s.root, 360, 760, 620, "#FFF4C9", { alpha = 0.8, soft = true })
	ui.pulse(glow, 0.06, 1.2)

	local logo = s:image(s.root, "logo/logo", 360, 760, { scale = 1.0 })
	if not logo then
		logo = s:text(s.root, i18n.t("app.title"), 360, 760, {
			font = "title", size = 200, color = "pink", outline = "white", shadow = "shadow",
		})
	end
	ui.pop_in(logo, 0.05, 0.4)

	local tag = s:text(s.root, i18n.t("splash.tagline"), 360, 560, {
		font = "button", size = 40, color = "white", outline = "#2F80ED", shadow = "#2F80ED", max_width = 640,
	})
	gui.set_color(tag, vmath.vector4(1, 1, 1, 0))
	gui.animate(tag, "color.w", 1, gui.EASING_OUTQUAD, 0.4, 0.35)

	-- three bouncing notes as a loading indicator
	for i = 1, 3 do
		local dot = s:circle(s.root, 300 + (i - 1) * 60, 300, 34, ({ "#FF4D8D", "#FFDB1A", "#3AA4FF" })[i])
		local p = gui.get_position(dot)
		gui.animate(dot, "position.y", p.y + 26, gui.EASING_INOUTSINE, 0.45, i * 0.15, nil, gui.PLAYBACK_LOOP_PINGPONG)
	end
	local loading = s:text(s.root, i18n.t("splash.loading"), 360, 230, { font = "body", size = 28, color = "text_soft" })
	s:anchor(loading, "bottom")

	self.t = 0
	self.done = false
end

function final(self)
	self.ui:final()
end

function update(self, dt)
	self.ui:update(dt)
	self.t = self.t + dt
	if not self.done and self.t >= DURATION and not app.transitioning then
		self.done = true
		notices()
		if app.first_launch() then
			app.show_screen("level", { level = 1, from = "splash" })
		else
			app.show_screen("town", { from = "splash" })
		end
	end
end

function on_input(self, action_id, action)
	return self.ui:on_input(action_id, action)
end
