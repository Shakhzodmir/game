-- Splash: the logo pops in over turning sun rays with a burst of sparkles,
-- the tagline slides up, Bit hops in and three notes bounce while the save
-- settles. After about 2 s (or a tap) the town opens, or level 1 straight
-- away on the very first launch (client-architecture.md, 3): its attempt is
-- opened through the meta like any other start (client/flow.lua).
-- On the way out it tells the player what the load did (app.load_notices:
-- restored from the backup, save unreadable, interrupted level, gifts,
-- chests).

local app = require("client.app")
local ui = require("client.ui")
local i18n = require("client.i18n")
local fx = require("client.fx")
local bit = require("client.bit")
local audio = require("client.audio")
local flow = require("client.flow")

local DURATION = 2.2
local TOUCH = hash("touch")

local function notices()
	for _, n in ipairs(app.load_notices()) do
		app.toast({ key = n.key, vars = n.vars }, { color = n.color, duration = 3 })
	end
end

local function go(self)
	if self.done then return end
	self.done = true
	notices()
	if app.first_launch() then
		local ok = flow.start(1, {}, "splash")
		if ok then return end
	end
	app.show_screen("town", { from = "splash" })
end

function init(self)
	msg.post(".", "acquire_input_focus")
	local s = ui.scene({ gui = "/screens/splash/splash.gui" })
	self.ui = s
	local reduced = app.reduced_motion()
	s:sky()
	self.fx = fx.new(s, s.root)

	-- sun rays and a warm glow behind the logo
	self.fx:rays(s.root, 360, 780, { count = 12, length = 1500, width = 120, alpha = 0.28, color = "#FFF4C9", period = 24 })
	local glow = s:circle(s.root, 360, 780, 700, "#FFF4C9", { alpha = 0.85, soft = true })
	if not reduced then ui.pulse(glow, 0.06, 1.2) end

	local logo = s:image(s.root, "logo/logo", 360, 800, { scale = 1.0 })
	if not logo then
		logo = s:text(s.root, i18n.t("app.title"), 360, 800, {
			font = "title", size = 200, color = "pink", outline = "white", shadow = "shadow",
		})
	end
	self.logo = logo
	if not reduced then
		local sc = gui.get_scale(logo)
		gui.set_scale(logo, sc * 0.01)
		gui.animate(logo, "scale", sc * 1.12, gui.EASING_OUTBACK, 0.45, 0.1, function()
			gui.animate(logo, "scale", sc, gui.EASING_OUTELASTIC, 0.6)
			local p = gui.get_position(logo)
			gui.animate(logo, "position.y", p.y + 10, gui.EASING_INOUTSINE, 1.2, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
		end)
		self.fx:after(0.4, function()
			self.fx:flash(360, 800, { size = 900, dur = 0.5 })
			self.fx:burst(360, 800, { count = 22, radius = 340, size = 42 })
			audio.sfx("unlock")
		end)
	end

	local tag = s:text(s.root, i18n.t("splash.tagline"), 360, 580, {
		font = "button", size = 42, color = "white", outline = "#2F80ED", shadow = "#2F80ED", max_width = 640,
	})
	gui.set_color(tag, vmath.vector4(1, 1, 1, 0))
	gui.animate(tag, "color.w", 1, gui.EASING_OUTQUAD, 0.4, reduced and 0 or 0.55)
	if not reduced then
		gui.set_position(tag, vmath.vector3(360, 530, 0))
		gui.animate(tag, "position.y", 580, gui.EASING_OUTBACK, 0.5, 0.55)
	end

	-- Bit hops in
	local holder = s:layer(s.root)
	s:anchor(holder, "bottom")
	self.bit = bit.new(s, holder, 360, 380, 190)
	if not reduced then
		self.fx:after(0.7, function() self.bit:cheer(1.4, 2) end)
	end

	-- three bouncing notes as a loading indicator
	for i = 1, 3 do
		local dot = s:circle(s.root, 300 + (i - 1) * 60, 200, 34, ({ "#FF4D8D", "#FFDB1A", "#3AA4FF" })[i])
		s:anchor(dot, "bottom")
		if not reduced then
			local p = gui.get_position(dot)
			gui.animate(dot, "position.y", p.y + 26, gui.EASING_INOUTSINE, 0.45, i * 0.15, nil, gui.PLAYBACK_LOOP_PINGPONG)
		end
	end
	local loading = s:text(s.root, i18n.t("splash.loading"), 360, 140, { font = "body", size = 28, color = "text_soft" })
	s:anchor(loading, "bottom")

	self.t = 0
	self.done = false
	app.ui = { screen = "splash" }
end

function final(self)
	self.ui:final()
end

function update(self, dt)
	self.ui:update(dt)
	self.fx:update(dt)
	self.bit:update(dt)
	self.t = self.t + dt
	if not self.done and self.t >= DURATION and not app.transitioning then go(self) end
end

function on_input(self, action_id, action)
	-- a tap skips the wait (once the save has settled)
	if action_id == TOUCH and action.released and self.t > 0.8 and not app.transitioning then
		go(self)
		return true
	end
	return self.ui:on_input(action_id, action)
end
